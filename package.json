{
	"name": "@wdns/vue-code-block",
	"version": "2.3.5",
	"description": "Vue 3 CodeBlock - Highlight your code with ease using this syntax highlighting component powered by PrismJS or Highlight.js.",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/vue-code-block.cjs.js",
	"module": "dist/vue-code-block.es.js",
	"types": "dist/plugin/types/index.d.ts",
	"scripts": {
		"dev": "NODE_OPTIONS='--no-warnings' vite",
		"watch": "pnpm dev",
		"play": "sh src/playground/configs/build.sh && NODE_ENV=playground pnpm dev",
		"build": "tsc -p tsconfig.build.json && pnpm test:build && vite build --config vite.build.config.mts",
		"build:docs": "vite build",
		"predeploy": "pnpm build",
		"deploy": "gh-pages -d docs",
		"prepublishOnly": "pnpm build",
		"lint": "eslint src/**/*.{ts,vue} --max-warnings 4 --no-warn-ignored",
		"prepare": "husky",
		"test:dev": "vitest",
		"test:all": "vitest --run",
		"test:build": "vitest --run --bail 1",
		"sass": "sass --watch --no-source-map src/plugin/themes/scss/:src/plugin/themes/css",
		"sass:min": "sass --style compressed --watch --no-source-map src/plugin/themes/scss/:src/plugin/themes/css/min"
	},
	"lint-staged": {
		"src/**/*.{js,ts,vue}": [
			"npm run lint"
		]
	},
	"author": "WebDevNerdStuff & Bunnies... lots and lots of bunnies! <webdevnerdstuff@gmail.com> (https://webdevnerdstuff.com)",
	"funding": [
		{
			"type": "paypal",
			"url": "https://paypal.me/webdevnerdstuff"
		},
		{
			"type": "patreon",
			"url": "https://www.patreon.com/WebDevNerdStuff"
		}
	],
	"license": "MIT",
	"files": [
		"dist/*",
		"LICENSE.md",
		"README.md"
	],
	"repository": "https://github.com/webdevnerdstuff/vue-code-block",
	"bugs": {
		"url": "https://github.com/webdevnerdstuff/vue-code-block/issues"
	},
	"homepage": "https://webdevnerdstuff.github.io/vue-code-block/",
	"keywords": [
		"vue-code-block",
		"code",
		"pre",
		"highlight",
		"syntax",
		"vue",
		"vue3",
		"prism",
		"prismjs",
		"highlightjs",
		"highlight.js",
		"component",
		"javascript",
		"typescript",
		"neon bunny",
		"webdevnerdstuff",
		"wdns"
	],
	"dependencies": {
		"highlight.js": "^11.12.0",
		"prismjs": "^1.30.0",
		"ua-parser-js": "^2.0.10",
		"vue": "^3.5.44"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@fortawesome/fontawesome-svg-core": "^6.7.2",
		"@fortawesome/free-brands-svg-icons": "^6.7.2",
		"@fortawesome/free-regular-svg-icons": "^6.7.2",
		"@fortawesome/free-solid-svg-icons": "^6.7.2",
		"@fortawesome/vue-fontawesome": "^3.3.3",
		"@mdi/font": "^7.4.47",
		"@rollup/plugin-commonjs": "^28.0.9",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^0.4.4",
		"@stylistic/stylelint-plugin": "^3.1.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.20.5",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitejs/plugin-vue": "^5.2.4",
		"@vue/cli-service": "^5.0.9",
		"@vue/eslint-config-typescript": "^14.9.0",
		"@vue/test-utils": "^2.5.1",
		"@wdns/eslint-config-wdns": "^1.0.15",
		"@wdns/stylelint-config-wdns": "^1.0.2",
		"autoprefixer": "^10.6.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-import-resolver-typescript": "^3.10.1",
		"eslint-plugin-vue": "^9.33.0",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"lint-staged": "^15.5.2",
		"pinia": "^2.3.1",
		"postcss": "^8.5.30",
		"postcss-html": "^1.8.1",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.9.10",
		"rollup": "^4.64.10",
		"rollup-plugin-polyfill-node": "^0.13.0",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-scss": "^4.0.1",
		"rollup-plugin-typescript2": "^0.36.0",
		"sass": "^1.105.2",
		"stylelint": "^16.26.1",
		"stylelint-config-standard": "^36.0.1",
		"stylelint-order": "^6.0.4",
		"stylelint-scss": "^6.14.0",
		"typescript": "~5.7.3",
		"typescript-eslint": "^8.71.2",
		"unplugin-auto-import": "^0.19.0",
		"vite": "^6.4.4",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-eslint2": "^5.3.0",
		"vite-plugin-static-copy": "^2.3.2",
		"vite-plugin-stylelint": "^6.3.0",
		"vite-plugin-vuetify": "^2.1.3",
		"vitest": "^2.1.9",
		"vue-tsc": "^2.2.12",
		"vuetify": "^3.13.7",
		"webfontloader": "^1.6.28"
	}
}
